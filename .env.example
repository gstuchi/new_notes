# Copie este arquivo para .env e coloque sua chave de verdade.
# O arquivo .env NUNCA vai para o controle de versao (ja esta no .gitignore).

# --- Opcao 1: Gemini (tem cota gratuita) -----------------------------------
# Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=cole-sua-chave-aqui

# --- Opcao 2: Anthropic (pago por foto) ------------------------------------
# Chave em https://console.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-...

# Basta UMA das duas. Com as duas configuradas, o Gemini atende (e o gratuito).
# Para forcar na mao: gemini ou anthropic
# PROVEDOR_VISION=gemini

# Modelo, se quiser sair do padrao do provedor
# (padrao: gemini-3.6-flash / claude-opus-5)
# MODELO_VISION=gemini-3.6-flash

# Opcional: porta do servidor local (padrao 3000)
PORTA=3000
